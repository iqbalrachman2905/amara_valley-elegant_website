---
import { buildWaLink } from '../lib/format.js';

const { content } = Astro.props;
const waLink = buildWaLink(content.whatsapp_number, `Halo, saya punya pertanyaan lain tentang ${content.hero_title || 'Amara Valley'} yang belum ada di FAQ.`);

const faqKeys = Object.keys(content)
  .filter((key) => /^faq_home_\d+$/.test(key))
  .sort((a, b) => Number(a.split('_')[2]) - Number(b.split('_')[2]));

const faqs = faqKeys
  .map((key, i) => {
    const [question, answer] = String(content[key] || '').split('::');
    const cleanQ = String(question || '').replace(/^\s*\d+[.)]\s*/, '').trim();
    return cleanQ && answer ? { no: i + 1, question: cleanQ, answer: answer.trim() } : null;
  })
  .filter(Boolean);
---

{faqs.length > 0 && (
  <section id="faq" class="faq">
    <div class="container faq-grid">
      <div class="faq-intro" data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2>Pertanyaan yang sering diajukan</h2>
        <p class="sec-lead">Tidak menemukan jawaban Anda? Tim kami siap membantu lewat WhatsApp — biasanya membalas dalam beberapa menit pada jam kerja.</p>
        <div class="faq-actions">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-ink btn-sm">Tanya Langsung</a>
        </div>
      </div>

      <div class="faq-list" data-reveal style="--reveal-delay: 120ms">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>
              <span class="faq-no">{String(f.no).padStart(2, '0')}</span>
              <span class="faq-q">{f.question}</span>
              <span class="faq-toggle" aria-hidden="true"></span>
            </summary>
            <div class="faq-a"><p>{f.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .faq {
    background: var(--color-bg-paper);
    padding-block: clamp(64px, 9vw, 116px);
  }
  .faq-grid { display: grid; gap: clamp(34px, 5vw, 70px); }
  .faq-intro { max-width: 430px; }
  .faq-intro h2 { margin: 16px 0 18px; font-size: clamp(1.8rem, 3.4vw, 2.7rem); }
  .faq-actions { margin-top: 26px; }

  .faq-list { border-top: 1px solid var(--color-border); }
  .faq-item { border-bottom: 1px solid var(--color-border); }
  .faq-item summary {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 22px);
    cursor: pointer;
    list-style: none;
    padding-block: clamp(16px, 2.2vw, 24px);
    transition: background var(--duration-normal) var(--ease-out);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { background: color-mix(in srgb, var(--color-bg-paper) 55%, transparent); }
  .faq-no {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--color-secondary);
    flex: none;
    min-width: 30px;
  }
  .faq-q {
    flex: 1;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    color: var(--color-primary);
  }
  .faq-toggle {
    flex: none;
    position: relative;
    width: 15px;
    height: 15px;
    margin-right: 4px;
  }
  .faq-toggle::before,
  .faq-toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.6px;
    background: var(--color-secondary);
    transition: transform var(--duration-normal) var(--ease-out);
  }
  .faq-toggle::after { transform: rotate(90deg); }
  .faq-item[open] .faq-toggle::after { transform: rotate(0deg); }
  .faq-a {
    padding: 0 clamp(44px, 8vw, 90px) clamp(18px, 2vw, 24px) 44px;
  }
  .faq-a p {
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    max-width: 62ch;
  }
  @media (min-width: 1024px) {
    .faq-grid { grid-template-columns: 0.75fr 1.25fr; }
    .faq-intro { position: sticky; top: 120px; align-self: start; }
  }
</style>
