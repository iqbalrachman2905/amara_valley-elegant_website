---
const { content } = Astro.props;

const trustKeys = ['trust_points_1', 'trust_points_2', 'trust_points_3', 'trust_points_4'];

const ICONS = [
  // Pengembang Terpercaya — mahkota kecil
  '<path d="M5 8.5 12 3l7 5.5v6L12 21l-7-5.5v-6.5Z"/><path d="M8 12h8M9.5 12v3.2a2.5 2.5 0 0 0 5 0V12"/>',
  // Legalitas — segel
  '<path d="M12 3v4M12 21v-4M5.6 7.2 9 9.6M18.4 7.2 15 9.6M3.8 12H7M17 12h3.2M5.6 16.8 9 14.4M18.4 16.8 15 14.4"/><circle cx="12" cy="12" r="3.2"/>',
  // Desain & material — berlian
  '<path d="M6 3h12l4 6-10 12L2 9l4-6Z"/><path d="M2 9h20M12 21 8.5 9M12 21l3.5-12M6.5 3 9 9M17.5 3 15 9"/>',
  // Tepat waktu — jam pasir / kalender
  '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 3v6l4 3 4-3V3M8 21v-6l4-3 4 3v6"/><path d="M8 3h8M8 21h8"/>'
];

const trustItems = trustKeys.map((key, i) => {
  if (!content[key]) return null;
  const [title, desc] = String(content[key]).split('::');
  if (!title?.trim()) return null;
  return { title: title.trim(), desc: desc?.trim() || '', icon: ICONS[i % ICONS.length] };
}).filter(Boolean);
---

{trustItems.length > 0 && (
  <section class="trust" aria-label="Keunggulan Amara Land">
    <div class="container">
      <div class="trust-grid">
        {trustItems.map((item, i) => (
          <article class="trust-item" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="trust-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="trust-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g set:html={item.icon} /></svg>
            </span>
            <h3 class="trust-title">{item.title}</h3>
            <p class="trust-desc">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .trust {
    background: var(--color-bg-paper);
    padding-block: clamp(52px, 7vw, 88px);
  }
  .trust-grid {
    display: grid;
    gap: var(--space-md);
  }
  .trust-item {
    position: relative;
    background: var(--color-bg-main);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: clamp(24px, 3vw, 36px) clamp(22px, 3vw, 32px);
  }
  .trust-index {
    position: absolute;
    top: 18px;
    right: 20px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: color-mix(in srgb, var(--color-primary) 14%, transparent);
  }
  .trust-icon {
    display: inline-flex;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-secondary) 55%, transparent);
    border-radius: var(--radius-full);
    color: var(--color-secondary);
    margin-bottom: 18px;
  }
  .trust-title {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }
  .trust-desc {
    font-size: 0.9rem;
    line-height: var(--leading-relaxed);
    color: var(--color-muted);
    max-width: 40ch;
  }
  @media (min-width: 700px) {
    .trust-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1080px) {
    .trust-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
