---
const { content } = Astro.props;

const trustKeys = ['trust_points_1', 'trust_points_2', 'trust_points_3', 'trust_points_4'];

const icons = [
  // Pengembang Terpercaya - sparkle
  { color: 'var(--color-gold)', path: 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z' },
  // Legalitas Terjamin - check badge
  { color: 'var(--color-navy)', path: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z' },
  // Kualitas Desain & Material - star
  { color: 'var(--color-gold)', path: 'M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.562.562 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z' },
  // Pembangunan Tepat Waktu - building
  { color: 'var(--color-navy)', path: 'M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21' }
];

const trustItems = trustKeys.map((key, i) => {
  if (content[key]) {
    const [title, desc] = content[key].split('::');
    return {
      title: title?.trim(),
      desc: desc?.trim(),
      icon: icons[i]
    };
  }
  return null;
}).filter(Boolean);
---

<section id="trusted" class="trusted-section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">Kenapa Memilih Kami</span>
      <h2>Alasan Ratusan Keluarga Percaya Kami</h2>
    </div>

    <div class="trust-grid" style={`--cols:${trustItems.length}`}>
      {trustItems.map((item, i) => (
        <div class="trust-item" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
          <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke={item.icon.color} stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d={item.icon.path} />
          </svg>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-heading {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .trusted-section {
    padding-block: var(--space-xl);
    background: var(--color-white);
  }
  
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), 1fr);
    gap: 0;
  }
  
  .trust-item {
    padding: var(--space-xs) var(--space-md);
    text-align: center;
    border-left: var(--border-width) solid var(--color-border);
  }
  
  .trust-item:first-child {
    border-left: none;
  }
  
  .trust-icon {
    width: 36px;
    height: 36px;
    margin-bottom: var(--space-sm);
  }
  
  .trust-item h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  
  .trust-item p {
    font-size: 0.82rem;
    color: var(--color-navy-soft);
    line-height: 1.6;
  }

  @media (max-width: 767px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md) 0;
    }
    .trust-item {
      border-left: none;
    }
    .trust-item:nth-child(2n) {
      border-left: var(--border-width) solid var(--color-border);
    }
  }
</style>
