---
import { buildWaLink } from '../lib/format.js';

const { content } = Astro.props;
const waLink = buildWaLink(content.whatsapp_number, `Halo, saya tertarik dengan ${content.hero_title || 'Amara Valley'}. Boleh info lebih lanjut?`);

const navLinks = [
  { href: '#tentang', label: 'Tentang' },
  { href: '#unit', label: 'Tipe Unit' },
  { href: '#siteplan', label: 'Siteplan' },
  { href: '#lokasi', label: 'Lokasi' },
  { href: '#kpr', label: 'Simulasi KPR' }
];

const brandName = content.hero_title || content.company_name || 'Amara Valley';
---

<header class="navbar" data-navbar>
  <div class="container navbar-inner">
    <a href="#" class="brand" aria-label={`${brandName} — kembali ke atas`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="34" height="34" fill="none" aria-hidden="true">
          <rect x="2" y="2" width="60" height="60" rx="12" stroke="currentColor" stroke-width="2.6" />
          <path d="M16 46V23.5a3 3 0 0 1 3-3h7.5a3 3 0 0 1 3 3V46M16 46h9M16 36h13.5M35 46V17.5a3 3 0 0 1 3-3h7a3 3 0 0 1 3 3V46m0 0V27h6.5a2.5 2.5 0 0 1 2.5 2.5V46" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">{brandName}</span>
        <span class="brand-tag">Classic Living · Depok</span>
      </span>
    </a>

    <nav class="nav-links" aria-label="Navigasi utama">
      {navLinks.map(link => (
        <a href={link.href} data-spy-link={link.href.slice(1)}>{link.label}</a>
      ))}
    </nav>

    <div class="navbar-actions">
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-sm btn-wa">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.464 3.482 1.345 4.997L2 22l5.117-1.334a9.965 9.965 0 0 0 4.887 1.28h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.928-7.07a9.935 9.935 0 0 0-7.073-2.876zm0 18.184a8.16 8.16 0 0 1-4.166-1.14l-.299-.177-3.037.792.81-2.96-.194-.304a8.147 8.147 0 0 1-1.247-4.348c0-4.507 3.667-8.174 8.176-8.174 2.183 0 4.235.852 5.78 2.398a8.12 8.12 0 0 1 2.394 5.783c0 4.508-3.667 8.13-8.217 8.13zm4.468-6.12c-.248-.124-1.4-.69-1.616-.768-.217-.078-.375-.116-.533.116-.157.233-.61.769-.747.927-.137.158-.275.178-.51.059-.234-.12-.99-.365-1.885-1.164-.698-.622-1.168-1.388-1.304-1.62-.137-.233-.015-.36.102-.477.105-.105.275-.273.412-.411.137-.137.183-.233.275-.389.091-.156.045-.291-.02-.408-.065-.116-.583-1.404-.799-1.922-.21-.505-.424-.437-.583-.445l-.497-.01c-.172 0-.45.064-.685.32-.234.256-.895.874-.895 2.132 0 1.257.915 2.472 1.042 2.649.128.176 1.797 2.746 4.356 3.852.608.263 1.084.42 1.454.538.626.199 1.195.171 1.645.104.508-.076 1.4-.573 1.6-1.126.198-.553.198-1.026.138-1.126-.06-.1-.217-.16-.451-.279z"/></svg>
        <span>WhatsApp</span>
      </a>
      <button class="nav-toggle" data-nav-toggle aria-label="Buka menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="nav-mobile" data-nav-mobile aria-label="Navigasi mobile">
    <div class="nav-mobile-inner">
      <p class="nav-mobile-label">Menu</p>
      {navLinks.map(link => (
        <a href={link.href} data-spy-link={link.href.slice(1)}>
          {link.label}
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      ))}
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-wa-mobile">Chat WhatsApp</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const mobileNav = document.querySelector('[data-nav-mobile]');
  const navbar = document.querySelector('[data-navbar]');

  toggle?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Tutup menu' : 'Buka menu');
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });

  mobileNav?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      mobileNav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });

  const onScroll = () => {
    navbar?.classList.toggle('is-scrolled', window.scrollY > 30);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Halaman tanpa hero (artikel, dsb.): navbar langsung mode terang.
  if (!document.querySelector('[data-hero]')) {
    navbar?.classList.add('is-scrolled');
  }

  const spyLinks = Array.from(document.querySelectorAll('[data-spy-link]'));
  const spySections = spyLinks
    .map(l => document.getElementById(l.getAttribute('data-spy-link')))
    .filter(Boolean);

  if ('IntersectionObserver' in window && spySections.length > 0) {
    const spy = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        spyLinks.forEach(l =>
          l.classList.toggle('is-active', l.getAttribute('data-spy-link') === entry.target.id)
        );
      });
    }, { rootMargin: '-35% 0px -55% 0px' });
    spySections.forEach(s => spy.observe(s));
  }
</script>

<style>
  .navbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-navbar);
    background: linear-gradient(to bottom, rgba(24, 20, 13, 0.34), transparent);
    transition: background var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      backdrop-filter var(--duration-normal) var(--ease-out);
  }
  .navbar.is-scrolled {
    background: color-mix(in srgb, var(--color-bg-main) 86%, transparent);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-primary) 7%, transparent), var(--shadow-sm);
  }
  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: 14px;
  }
  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-bg-main);
    transition: color var(--duration-normal) var(--ease-out);
  }
  .navbar.is-scrolled .brand { color: var(--color-primary); }
  .brand-mark {
    display: inline-flex;
    color: var(--color-gold-light);
  }
  .navbar.is-scrolled .brand-mark { color: var(--color-secondary); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .brand-tag {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    opacity: 0.72;
    margin-top: 2px;
  }
  /* Nav desktop */
  .nav-links {
    display: none;
    align-items: center;
    gap: clamp(14px, 2.2vw, 30px);
  }
  .nav-links a {
    position: relative;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--color-bg-main) 88%, transparent);
    padding-block: 6px;
    transition: color var(--duration-normal) var(--ease-out);
  }
  .navbar.is-scrolled .nav-links a { color: var(--color-muted); }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--color-gold-light);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-normal) var(--ease-out);
  }
  .navbar.is-scrolled .nav-links a::after { background: var(--color-secondary); }
  .nav-links a:hover { color: var(--color-bg-main); }
  .navbar.is-scrolled .nav-links a:hover { color: var(--color-primary); }
  .nav-links a:hover::after,
  .nav-links a.is-active::after { transform: scaleX(1); }
  .nav-links a.is-active { color: var(--color-bg-main); }
  .navbar.is-scrolled .nav-links a.is-active { color: var(--color-primary); }

  .navbar-actions { display: flex; align-items: center; gap: 12px; }
  .navbar.is-scrolled .btn-wa { display: inline-flex; }

  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: 1px solid var(--glass-border-hero);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: background var(--duration-normal) var(--ease-out);
  }
  .navbar.is-scrolled .nav-toggle { border-color: color-mix(in srgb, var(--color-primary) 25%, transparent); }
  .nav-toggle span {
    display: block;
    height: 1.6px;
    width: 100%;
    background: var(--color-bg-main);
    border-radius: 2px;
    transition: transform var(--duration-normal) var(--ease-out), background var(--duration-normal) var(--ease-out);
  }
  .navbar.is-scrolled .nav-toggle span { background: var(--color-primary); }

  /* Mobile nav overlay */
  .nav-mobile {
    position: fixed;
    inset: 0;
    background: var(--color-bg-main);
    z-index: calc(var(--z-navbar) - 1);
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-out), transform var(--duration-normal) var(--ease-out);
  }
  .nav-mobile.is-open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .nav-mobile-inner {
    min-height: 100svh;
    padding: 108px var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .nav-mobile-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-secondary);
    margin-bottom: var(--space-sm);
  }
  .nav-mobile-inner > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 15px;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.55rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-primary);
  }
  .btn-wa-mobile { margin-top: var(--space-md); }

  @media (min-width: 1024px) {
    .nav-links { display: flex; }
    .nav-toggle { display: none; }
    .nav-mobile { display: none; }
  }
</style>
