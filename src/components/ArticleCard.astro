---
import { formatDate } from '../lib/format.js';
import { withBase } from '../lib/paths.js';

const { article, coverSrc } = Astro.props;
const href = withBase(`artikel/${article.slug}/`);
const firstTag = Array.isArray(article.tags) && article.tags.length > 0 ? article.tags[0] : null;
---

<article class="article-card">
  <a href={href} class="article-link">
    {coverSrc && (
      <span class="article-cover">
        <img src={coverSrc} alt="" width={600} height={400} loading="lazy" />
      </span>
    )}
    <span class="article-meta">
      {article.published_at && <time datetime={article.published_at}>{formatDate(article.published_at)}</time>}
      {firstTag && <span class="article-tag">{firstTag}</span>}
    </span>
    <h3 class="article-title">{article.title}</h3>
    <span class="article-more">
      Baca artikel
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m0 0-6-6m6 6-6 6"/></svg>
    </span>
  </a>
</article>

<style>
  .article-card {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
  }
  .article-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
  }
  .article-cover {
    border-radius: var(--radius-sm);
    overflow: hidden;
    order: -1;
  }
  .article-cover img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }
  .article-link:hover .article-cover img { transform: scale(1.04); }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
  }
  .article-tag {
    color: var(--color-secondary);
  }
  .article-title {
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    line-height: var(--leading-snug);
    transition: color var(--duration-normal) var(--ease-out);
  }
  .article-card:hover .article-title { color: var(--color-secondary); }
  .article-more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  .article-more svg { transition: transform var(--duration-normal) var(--ease-out); }
  .article-card:hover .article-more svg { transform: translateX(5px); }
</style>
