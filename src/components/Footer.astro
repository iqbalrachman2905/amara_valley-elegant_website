---
import { buildWaLink } from '../lib/format.js';
import { withBase } from '../lib/paths.js';

const { content } = Astro.props;
const waLink = buildWaLink(content.whatsapp_number, `Halo, saya tertarik dengan ${content.hero_title || 'Amara Valley'}.`);
const year = new Date().getFullYear();

const home = withBase('');
const logoUrl = withBase('favicon.svg');

const exploreLinks = [
  { href: `${home}#tentang`, label: 'Tentang' },
  { href: `${home}#unit`, label: 'Tipe Unit' },
  { href: withBase('tim/'), label: 'Tim Kami' },
  { href: `${home}#spesifikasi`, label: 'Spesifikasi' },
  { href: `${home}#siteplan`, label: 'Siteplan' },
  { href: `${home}#lokasi`, label: 'Lokasi' },
  { href: `${home}#galeri`, label: 'Galeri' },
  { href: `${home}#promo`, label: 'Penawaran' },
  { href: `${home}#faq`, label: 'FAQ' },
  { href: withBase('artikel/'), label: 'Artikel' }
];

const contactLinks = [];
if (content.footer_phone) contactLinks.push({ href: `tel:${String(content.footer_phone).replace(/[^0-9+]/g, '')}`, label: String(content.footer_phone), icon: 'phone' });
if (content.footer_email) contactLinks.push({ href: `mailto:${content.footer_email}`, label: content.footer_email, icon: 'mail' });
if (content.whatsapp_number) contactLinks.push({ href: waLink, label: 'Chat WhatsApp', icon: 'wa', external: true });
if (content.address && !/\(opsional/i.test(String(content.address))) {
  contactLinks.push({ href: `${home}#lokasi`, label: String(content.address), icon: 'pin' });
}

// Ambil semua kemungkinan key sosial dari sheet Content — biar kalau sheet
// ditambah kolom facebook_url / youtube_url / x_url / tiktok_url langsung
// muncul otomatis tanpa harus ubah kode lagi.
function pickSocial(keys) {
  for (const k of keys) {
    const v = content[k];
    if (v && String(v).trim() && String(v).trim() !== '-' && !/opsional/i.test(String(v))) {
      return String(v).trim();
    }
  }
  return null;
}

const socialDefs = [
  { keys: ['instagram_url', 'instagram', 'ig_url'], label: 'Instagram', icon: 'ig' },
  { keys: ['facebook_url', 'facebook', 'fb_url', 'fb'], label: 'Facebook', icon: 'fb' },
  { keys: ['youtube_url', 'youtube', 'yt_url', 'yt'], label: 'YouTube', icon: 'yt' },
  { keys: ['x_url', 'twitter_url', 'twitter', 'x', 'twitter_x_url'], label: 'X', icon: 'x' },
  { keys: ['tiktok_url', 'tiktok'], label: 'TikTok', icon: 'tt' },
  { keys: ['linkedin_url', 'linkedin'], label: 'LinkedIn', icon: 'li' },
];

const socialLinks = socialDefs
  .map(def => {
    const href = pickSocial(def.keys);
    return href ? { href, label: def.label, icon: def.icon, external: true } : null;
  })
  .filter(Boolean);

const ICONS = {
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  wa: '<path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.464 3.482 1.345 4.997L2 22l5.117-1.334a9.965 9.965 0 0 0 4.887 1.28h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.928-7.07a9.935 9.935 0 0 0-7.073-2.876zm0 18.184a8.16 8.16 0 0 1-4.166-1.14l-.299-.177-3.037.792.81-2.96-.194-.304a8.147 8.147 0 0 1-1.247-4.348c0-4.507 3.667-8.174 8.176-8.174 2.183 0 4.235.852 5.78 2.398a8.12 8.12 0 0 1 2.394 5.783c0 4.508-3.667 8.13-8.217 8.13zm4.468-6.12c-.248-.124-1.4-.69-1.616-.768-.217-.078-.375-.116-.533.116-.157.233-.61.769-.747.927-.137.158-.275.178-.51.059-.234-.12-.99-.365-1.885-1.164-.698-.622-1.168-1.388-1.304-1.62-.137-.233-.015-.36.102-.477.105-.105.275-.273.412-.411.137-.137.183-.233.275-.389.091-.156.045-.291-.02-.408-.065-.116-.583-1.404-.799-1.922-.21-.505-.424-.437-.583-.445l-.497-.01c-.172 0-.45.064-.685.32-.234.256-.895.874-.895 2.132 0 1.257.915 2.472 1.042 2.649.128.176 1.797 2.746 4.356 3.852.608.263 1.084.42 1.454.538.626.199 1.195.171 1.645.104.508-.076 1.4-.573 1.6-1.126.198-.553.198-1.026.138-1.126-.06-.1-.217-.16-.451-.279z"/>',
  ig: '<rect x="2.5" y="2.5" width="19" height="19" rx="5"/><circle cx="12" cy="12" r="4.4"/><circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" stroke="none"/>',
  fb: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3V2z"/>',
  yt: '<path d="M22.5 12c0-1.5-.1-2.7-.3-3.7a2.2 2.2 0 0 0-1.5-1.5C19.7 6.5 12 6.5 12 6.5s-7.7 0-8.7.3A2.2 2.2 0 0 0 1.8 8.3C1.6 9.3 1.5 10.5 1.5 12s.1 2.7.3 3.7a2.2 2.2 0 0 0 1.5 1.5c1 .3 8.7.3 8.7.3s7.7 0 8.7-.3a2.2 2.2 0 0 0 1.5-1.5c.2-1 .3-2.2.3-3.7z"/><path d="M10 15.5 15.5 12 10 8.5v7z" fill="currentColor" stroke="none"/>',
  x: '<path d="M18.9 3h3.1l-6.8 7.8L23.2 21h-6.2l-4.9-6.4L6.5 21H3.4l7.3-8.3L3 3h6.4l4.4 5.8L18.9 3zm-1.1 16.2h1.7L8.4 4.9H6.5l11.3 14.3z"/>',
  tt: '<path d="M19.6 7.2a5 5 0 0 1-2.9-1V18a4.5 4.5 0 1 1-4.5-4.5c.2 0 .4 0 .6.1V15a3 3 0 1 0 2.4 2.9V3h2.5a5 5 0 0 0 1.9 4.2z"/>',
  li: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>'
};

const companyName = content.company_name || 'Amara Land';
const brandName = content.hero_title || 'Amara Valley';
const copyright = content.copyright_text || `© ${year} ${companyName}. All rights reserved.`;
const showAddress = content.address && !/\(opsional/i.test(String(content.address)) ? String(content.address) : null;
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={home || '#'} class="footer-brandlink" aria-label={`${brandName} — kembali ke atas`}>
          <span class="footer-logo-wrap" aria-hidden="true">
            <img src={logoUrl} alt="" width="40" height="40" loading="lazy" decoding="async" class="footer-logo" />
          </span>
          <span class="footer-brandname">{brandName}</span>
        </a>
        <p class="footer-desc">
          {content.tagline || `Hunian modern-classic di jantung Kota Depok.`}
          <br />Dikembangkan oleh {companyName}.
        </p>
        {showAddress && (
          <p class="footer-address">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><g set:html={ICONS.pin} /></svg>
            <span>{showAddress}</span>
          </p>
        )}
        {socialLinks.length > 0 && (
          <div class="footer-social">
            {socialLinks.map((s) => (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}>
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><g set:html={ICONS[s.icon]} /></svg>
                <span>{s.label}</span>
              </a>
            ))}
          </div>
        )}
      </div>

      <nav class="footer-col" aria-label="Jelajahi">
        <p class="footer-col-title">Jelajahi</p>
        <ul>
          {exploreLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer-col">
        <p class="footer-col-title">Hubungi Kami</p>
        <ul class="footer-contact">
          {contactLinks.map((c) => (
            <li>
              <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener noreferrer' : undefined}>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><g set:html={ICONS[c.icon]} /></svg>
                <span>{c.label}</span>
              </a>
            </li>
          ))}
        </ul>
        {content.bank_partner && (
          <p class="footer-bank">Bank partner: <strong>{content.bank_partner}</strong></p>
        )}
        {content.fasilitas && (
          <p class="footer-bank" style="margin-top: 12px">Fasilitas: <strong>{String(content.fasilitas).slice(0, 120)}</strong></p>
        )}
      </div>

      <div class="footer-col footer-promo">
        <p class="footer-col-title">Penawaran</p>
        <div class="footer-promo-card">
          <span class="footer-promo-dp">{content.promo_dp || 'DP 0%'}</span>
          <p>Kunci rumah {brandName} dengan cicilan ringan & booking ringkas.</p>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-sm">Booking Sekarang</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>{copyright}</p>
      <p class="footer-disclaimer">Harga, spesifikasi &amp; program promo dapat berubah sewaktu-waktu tanpa pemberitahuan. Sebagian foto merupakan ilustrasi/visualisasi; konfirmasi detail dengan tim marketing.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark);
    color: color-mix(in srgb, var(--color-bg-main) 74%, transparent);
    padding-top: clamp(60px, 8vw, 96px);
    border-top: 1px solid color-mix(in srgb, var(--color-gold-light) 18%, transparent);
  }
  .footer-top {
    display: grid;
    gap: 42px;
    padding-bottom: clamp(36px, 5vw, 56px);
  }
  .footer-brandlink {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-bg-main);
  }
  .footer-logo-wrap {
    display: inline-flex;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-bg-main) 8%, transparent);
    border: 1px solid rgba(250,248,243,0.14);
  }
  .footer-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .footer-brandname {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--color-bg-main);
  }
  .footer-desc {
    margin-top: 18px;
    font-size: 0.92rem;
    line-height: var(--leading-relaxed);
    max-width: 34ch;
  }
  .footer-address {
    margin-top: 14px;
    display: inline-flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 0.84rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-bg-main) 66%, transparent);
    max-width: 36ch;
  }
  .footer-address svg { flex: none; margin-top: 2px; color: var(--color-gold-light); }
  .footer-social { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .footer-social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: color-mix(in srgb, var(--color-bg-main) 66%, transparent);
    text-decoration: none;
    font-size: 0.85rem;
    border: 1px solid rgba(250, 248, 243, 0.16);
    border-radius: var(--radius-full);
    padding: 8px 16px;
    transition: color var(--duration-normal) var(--ease-out), border-color var(--duration-normal) var(--ease-out), background var(--duration-normal) var(--ease-out);
  }
  .footer-social a:hover { color: var(--color-gold-light); border-color: var(--color-gold-light); background: rgba(250,248,243,0.06); }

  .footer-col-title {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    color: var(--color-gold-light);
    margin-bottom: 20px;
  }
  .footer-col ul { list-style: none; display: grid; gap: 11px; }
  .footer-col ul a {
    color: color-mix(in srgb, var(--color-bg-main) 74%, transparent);
    text-decoration: none;
    font-size: 0.92rem;
    transition: color var(--duration-normal) var(--ease-out);
  }
  .footer-col ul a:hover { color: var(--color-bg-main); }
  .footer-contact li a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    word-break: break-all;
  }
  .footer-contact svg { color: var(--color-gold-light); flex: none; }
  .footer-bank { margin-top: 22px; font-size: 0.8rem; color: color-mix(in srgb, var(--color-bg-main) 55%, transparent); }
  .footer-bank strong { color: var(--color-bg-main); font-weight: 600; }

  .footer-promo-card {
    background: color-mix(in srgb, var(--color-bg-main) 5%, transparent);
    border: 1px solid rgba(250, 248, 243, 0.12);
    border-radius: var(--radius-md);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .footer-promo-dp {
    font-family: var(--font-display);
    font-size: 1.9rem;
    color: var(--color-gold-light);
    line-height: 1;
  }
  .footer-promo-card p { font-size: 0.86rem; line-height: 1.65; color: color-mix(in srgb, var(--color-bg-main) 66%, transparent); }

  .footer-bottom {
    border-top: 1px solid rgba(250, 248, 243, 0.1);
    padding-block: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--color-bg-main) 46%, transparent);
  }
  .footer-disclaimer { font-size: 0.68rem; max-width: 72ch; line-height: 1.7; }

  @media (min-width: 900px) {
    .footer-top { grid-template-columns: 1.25fr 0.65fr 0.9fr 1fr; }
  }
  @media (min-width: 760px) {
    .footer-bottom { flex-direction: row; justify-content: space-between; align-items: baseline; }
  }
</style>
