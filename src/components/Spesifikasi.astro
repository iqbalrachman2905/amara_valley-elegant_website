---
const { content } = Astro.props;

const specKeys = Object.keys(content).filter(key => key.startsWith('spec_'));
const specs = specKeys.map(key => {
  const [title, desc] = content[key].split('::');
  return { title, desc };
}).filter(item => item.title && item.desc);

// ---------------------------------------------------------------------------
// Ikon spesifik per jenis material - bukan lagi centang generik buat semua.
// Pencocokan lewat kata kunci di "title + desc" (lowercase), urutan matters:
// keyword paling spesifik dicek duluan (mis. "Tangki Air" harus kena ikon
// toren, BUKAN ikon air - makanya TOREN dicek sebelum AIR).
// Semua inline SVG stroke-based (gaya Lucide), gak ada request eksternal.
// ---------------------------------------------------------------------------
const ICON_PATHS = {
  // Pondasi / struktur bawah - ikon layers bertumpuk
  pondasi: '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  // Dinding bata - pola susun batu bata
  dinding: '<rect x="3" y="5" width="18" height="16" rx="1"/><path d="M3 10.33h18"/><path d="M3 15.66h18"/><path d="M9 5v5.33"/><path d="M15 10.33v5.33"/><path d="M9 15.66V21"/>',
  // Lantai - grid ubin
  lantai: '<rect x="3" y="3" width="18" height="18" rx="1"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/>',
  // Daun pintu
  pintu: '<path d="M18 20V6a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14"/><path d="M2 20h20"/><path d="M14 12v.01"/>',
  // Kusen / jendela
  jendela: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M12 4v16"/><path d="M4 12h16"/>',
  // Plafon - panel atas
  plafon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/>',
  // Toren / tandon air - bentuk tabung
  toren: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/>',
  // Atap + rangka - siluet rumah
  atap: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .71-1.53l7-6a2 2 0 0 1 2.58 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  // Sumber air - ombak
  air: '<path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>',
  // Listrik - petir
  listrik: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  // Fallback - kunci pas (material/bangunan lainnya)
  lainnya: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
};

// [keyIcon, [keywords]] - urutan = prioritas pencocokan.
const ICON_RULES = [
  ['pondasi', ['pondasi', 'fondasi', 'footing', 'struktur', 'sloof']],
  ['toren', ['toren', 'torn ', 'tandon', 'tangki', 'tank', 'water tank']],
  ['dinding', ['dinding', 'bata', 'hebel', 'wall']],
  ['lantai', ['lantai', 'tile', 'keramik', 'granit', 'marmer', 'floor']],
  ['pintu', ['pintu', 'door']],
  ['jendela', ['kusen', 'jendela', 'window', 'alumunium', 'aluminium']],
  ['plafon', ['plafon', 'ceiling', 'gypsum', 'hpl', 'kayu']],
  ['atap', ['atap', 'genteng', 'rangka', 'baja ringan', 'roof', 'kanopi']],
  ['air', ['air', 'bor', 'jet pump', 'pompa', 'sumur', 'sanitair', 'pipa']],
  ['listrik', ['listrik', 'watt', 'pln', 'kwh', 'elektrik', 'saklar', 'mcb']],
];

function pickIcon(title, desc) {
  const haystack = `${title} ${desc}`.toLowerCase();
  for (const [icon, keywords] of ICON_RULES) {
    if (keywords.some((kw) => haystack.includes(kw))) return icon;
  }
  return 'lainnya';
}

const specItems = specs.map((spec) => ({
  ...spec,
  title: spec.title.trim(),
  desc: spec.desc.trim(),
  icon: pickIcon(spec.title, spec.desc),
}));
---

<section id="spesifikasi" class="spesifikasi-section">
  <div class="container">
    <div class="section-heading" data-reveal>
      <span class="eyebrow">Kualitas Material</span>
      <h2>Spesifikasi Bangunan</h2>
      <p class="section-sub">Material terbaik untuk hunian yang awet puluhan tahun.</p>
    </div>

    {specItems.length > 0 ? (
      <div class="spec-grid">
        {specItems.map((spec, i) => (
          <div class="spec-item" data-reveal style={`--reveal-delay: ${(i % 5) * 70}ms`}>
            <span class="spec-icon" aria-hidden="true">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={ICON_PATHS[spec.icon]}
              />
            </span>
            <div class="spec-text">
              <h3>{spec.title}</h3>
              <p>{spec.desc}</p>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="spec-empty">
        Spesifikasi material sedang diperbarui. Hubungi tim marketing kami
        untuk detail terbaru.
      </p>
    )}
  </div>
</section>

<style>
  .spesifikasi-section {
    padding-block: var(--space-xl);
    background: var(--color-paper);
  }
  .section-heading {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .eyebrow {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-gold);
    margin-bottom: var(--space-xs);
  }
  .section-heading h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--color-navy);
  }
  .section-sub {
    max-width: 460px;
    margin: var(--space-xs) auto 0;
    color: var(--color-navy-soft);
    font-size: 0.95rem;
  }

  .spec-grid {
    max-width: 900px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--space-xl);
    row-gap: var(--space-sm);
  }

  .spec-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm);
    margin-inline: calc(var(--space-sm) * -1);
    border-radius: var(--radius-md);
    transition: background var(--duration-fast) var(--ease-out);
  }
  .spec-item:hover {
    background: color-mix(in srgb, var(--color-bg-main) 65%, transparent);
  }

  .spec-icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-gold) 72%, white), var(--color-gold));
    color: var(--color-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
    box-shadow: 0 3px 10px color-mix(in srgb, var(--color-gold) 30%, transparent);
  }

  .spec-text h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .spec-text p {
    font-size: 0.85rem;
    color: var(--color-navy-soft);
    line-height: 1.5;
  }

  .spec-empty {
    text-align: center;
    color: var(--color-navy-soft);
    padding: var(--space-lg) 0;
  }

  @media (max-width: 640px) {
    .spec-grid {
      grid-template-columns: 1fr;
      row-gap: var(--space-xs);
    }
  }
</style>
