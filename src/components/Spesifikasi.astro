---
const { content, specImgs = [] } = Astro.props;

const specKeys = Object.keys(content)
  .filter((key) => /^spec_\d+$/.test(key))
  .sort((a, b) => Number(a.split('_')[1]) - Number(b.split('_')[1]));

const specs = specKeys
  .map((key) => {
    const [title, desc] = String(content[key] || '').split('::');
    return { title: title?.trim(), desc: desc?.trim() };
  })
  .filter((s) => s.title && s.desc);
---

{specs.length > 0 && (
  <section id="spesifikasi" class="spec">
    <div class="container spec-grid">
      <div class="spec-intro">
        <p class="eyebrow" data-reveal>Spesifikasi Material</p>
        <h2 class="spec-title" data-reveal>
          Dibangun dengan bahan yang
          <em class="accent-serif">jujur</em> &amp; awet.
        </h2>
        <p class="sec-lead" data-reveal>
          Kami percaya rumah yang elegan lahir dari detail yang tidak terlihat —
          dari pondasi hingga atap, setiap material dipilih untuk kenyamanan jangka panjang.
        </p>

        <ul class="spec-highlights" data-reveal>
          <li>Lantai granit 60×60 <span>White Carrera</span></li>
          <li>Pintu utama <span>solid wood</span></li>
          <li>Listrik <span>PLN 2200 Watt</span></li>
        </ul>

        {specImgs[0] && (
          <figure class="spec-media" data-reveal>
            <img src={specImgs[0].src} alt="Material & detail hunian Amara Valley" width={specImgs[0].width} height={specImgs[0].height} loading="lazy" />
          </figure>
        )}
      </div>

      <ol class="spec-list" data-reveal>
        {specs.map((s, i) => (
          <li class="spec-row">
            <span class="spec-num">{String(i + 1).padStart(2, '0')}</span>
            <div class="spec-text">
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .spec {
    background: var(--color-bg-paper);
    padding-block: clamp(72px, 11vw, 132px);
  }
  .spec-grid {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
  }
  .spec-intro { max-width: 460px; }
  .spec-title { margin: 18px 0 20px; font-size: clamp(1.8rem, 3.2vw, 2.7rem); }
  .spec-highlights {
    list-style: none;
    display: grid;
    gap: 10px;
    margin-block: 26px;
  }
  .spec-highlights li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
    color: var(--color-primary);
  }
  .spec-highlights span {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-secondary);
  }
  .spec-media {
    margin-top: 30px;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .spec-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .spec-list {
    list-style: none;
    counter-reset: spec;
    border-top: 1px solid var(--color-border);
  }
  .spec-row {
    display: flex;
    align-items: baseline;
    gap: clamp(18px, 3vw, 40px);
    padding-block: clamp(16px, 2.2vw, 24px);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-normal) var(--ease-out), padding var(--duration-normal) var(--ease-out);
  }
  .spec-row:hover { background: var(--color-bg-main); padding-inline: clamp(8px, 1.6vw, 22px); }
  .spec-num {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--color-secondary);
    flex: none;
    min-width: 34px;
  }
  .spec-text { display: flex; flex-direction: column; gap: 3px; }
  .spec-text h3 {
    font-size: 1.22rem;
    font-weight: 500;
  }
  .spec-text p { color: var(--color-muted); line-height: var(--leading-normal); }

  @media (min-width: 1000px) {
    .spec-grid { grid-template-columns: 0.8fr 1.2fr; }
    .spec-intro { position: sticky; top: 120px; align-self: start; }
  }
</style>
