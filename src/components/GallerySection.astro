---
import GalleryLightbox from './GalleryLightbox.vue';

const { items, subtitle } = Astro.props;
---

{items.length > 0 && (
  <section id="galeri" class="galeri">
    <div class="container">
      <div class="galeri-head" data-reveal>
        <div>
          <p class="eyebrow">Galeri</p>
          <h2>Rasakan suasananya</h2>
        </div>
        <p class="galeri-note">{subtitle || 'Sebagian foto merupakan visualisasi & ilustrasi — foto asli dapat dilihat saat survey.'}</p>
      </div>
      <div data-reveal style="--reveal-delay: 120ms">
        <GalleryLightbox items={items} client:visible />
      </div>
    </div>
  </section>
)}

<style>
  .galeri {
    background: var(--color-bg-main);
    padding-block: clamp(56px, 8vw, 110px);
  }
  .galeri-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .galeri-head h2 { margin-top: 14px; font-size: clamp(1.8rem, 3.4vw, 2.7rem); }
  .galeri-note {
    max-width: 340px;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  @media (min-width: 860px) {
    .galeri-head { flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
</style>
