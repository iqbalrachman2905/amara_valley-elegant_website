---
import ArticleCard from './ArticleCard.astro';
import { withBase } from '../lib/paths.js';

const { articles, content } = Astro.props;
const latest = (articles || []).slice(0, 3);
---

{latest.length > 0 && (
  <section id="artikel" class="artikel-preview">
    <div class="container">
      <div class="artikel-head" data-reveal>
        <div>
          <p class="eyebrow">Artikel</p>
          <h2>Wawasan seputar <em class="accent-serif">rumah</em></h2>
        </div>
        <p class="artikel-note">Tips membeli rumah, KPR, hingga perkembangan kawasan — dirangkum untuk Anda.</p>
      </div>

      <div class="artikel-grid">
        {latest.map((a) => <ArticleCard article={a} coverSrc={a.coverSrc} />)}
      </div>

      <div class="artikel-more-wrap" data-reveal>
        <a href={withBase('artikel/')} class="btn btn-outline">
          Lihat Semua Artikel
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m0 0-6-6m6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .artikel-preview {
    background: var(--color-bg-paper);
    padding-block: clamp(56px, 8vw, 104px);
  }
  .artikel-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: clamp(30px, 4vw, 46px);
  }
  .artikel-head h2 { margin-top: 14px; font-size: clamp(1.8rem, 3.4vw, 2.7rem); }
  .artikel-note { max-width: 40ch; color: var(--color-muted); font-size: 0.92rem; }
  .artikel-grid {
    display: grid;
    gap: clamp(24px, 4vw, 46px);
  }
  .artikel-more-wrap { margin-top: clamp(30px, 4vw, 46px); }
  @media (min-width: 860px) {
    .artikel-head { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    .artikel-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
