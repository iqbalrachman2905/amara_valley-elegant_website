---
import { buildWaLink } from '../lib/format.js';

const { waNumber } = Astro.props;
const waLink = buildWaLink(waNumber, 'Halo, saya mau tanya-tanya tentang Puri Kencana Permai II Extension.');
---

{waNumber && (
  <a href={waLink} target="_blank" rel="noopener noreferrer" class="sticky-wa" aria-label="Chat WhatsApp">
    <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
      <path d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.464 3.482 1.345 4.997L2 22l5.117-1.334a9.965 9.965 0 0 0 4.887 1.28h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.928-7.07a9.935 9.935 0 0 0-7.073-2.876zm0 18.184a8.16 8.16 0 0 1-4.166-1.14l-.299-.177-3.037.792.81-2.96-.194-.304a8.147 8.147 0 0 1-1.247-4.348c0-4.507 3.667-8.174 8.176-8.174 2.183 0 4.235.852 5.78 2.398a8.12 8.12 0 0 1 2.394 5.783c0 4.508-3.667 8.13-8.217 8.13z" />
    </svg>
  </a>
)}

<style>
  .sticky-wa {
    position: fixed;
    bottom: var(--space-md);
    right: var(--space-md);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #25D366;
    color: var(--color-white);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-soft);
    z-index: var(--z-toast);
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .sticky-wa:hover {
    transform: scale(1.06);
  }
</style>
