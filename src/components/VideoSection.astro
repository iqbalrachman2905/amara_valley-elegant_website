---
const { videoId } = Astro.props;
---

{videoId && (
  <section id="video" class="video-section">
    <div class="container container-narrow">
      <div class="section-heading">
        <span class="eyebrow">Video</span>
        <h2>Lihat Video Cluster</h2>
      </div>

      <div class="video-facade" data-video-facade data-video-id={videoId} data-reveal>
        <img src={`https://img.youtube.com/vi/${videoId}/hqdefault.jpg`} alt="Thumbnail video" loading="lazy" />
        <button class="video-play-btn" aria-label="Putar video">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </button>
      </div>
    </div>
  </section>
)}

<script>
  // Iframe YouTube itu berat (nambah ratusan KB JS pihak ketiga) - jadi
  // sengaja BARU dimuat pas visitor beneran klik play, bukan otomatis pas
  // halaman dibuka. Sebelum diklik, yang ke-load cuma 1 gambar thumbnail.
  document.querySelectorAll('[data-video-facade]').forEach((facade) => {
    facade.addEventListener('click', () => {
      const videoId = facade.getAttribute('data-video-id');
      const iframe = document.createElement('iframe');
      
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = 'Video cluster';
      
      facade.replaceWith(iframe);
      iframe.className = 'video-iframe';
    }, { once: true });
  });
</script>

<style>
  .video-section {
    padding-block: var(--space-xl);
    background: var(--color-paper);
  }
  .container-narrow {
    max-width: 800px;
  }
  
  .section-heading {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .eyebrow {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-gold);
    margin-bottom: var(--space-xs);
  }
  .section-heading h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .video-facade {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: pointer;
    box-shadow: var(--shadow-soft);
  }
  .video-facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-primary) 85%, transparent);
    color: var(--color-white);
    border: none;
    display: grid;
    place-items: center;
  }

  :global(.video-iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }
</style>
