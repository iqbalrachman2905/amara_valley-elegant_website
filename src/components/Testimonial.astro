---
import { prettifyName } from '../lib/gender.js';

const { testimonials = [] } = Astro.props;

const items = (testimonials || [])
  .map((t) => {
    const name = prettifyName(t.name);
    const text = String(t.text || '').trim();
    const rateNum = Number(t.rate);
    const rate = Number.isFinite(rateNum) && rateNum > 0 ? Math.min(5, Math.round(rateNum)) : null;
    return { ...t, name, text, rate };
  })
  .filter((t) => t.name || t.text);

const hasItems = items.length > 0;
const STARS = [1, 2, 3, 4, 5];
const initials = (n) => n.trim().split(/\s+/).map((p) => p[0] || '').slice(0, 2).join('').toUpperCase();
---

{hasItems && (
  <section class="testi">
    <div class="container">
      <div class="testi-head" data-reveal>
        <p class="eyebrow">Testimoni</p>
        <h2>Kata mereka yang sudah <em class="accent-serif">tinggal</em></h2>
      </div>

      <div class="testi-list">
        {items.map((t, i) => (
          <figure class="testi-card" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <blockquote>
              <span class="testi-quote-mark" aria-hidden="true">&ldquo;</span>
              <p>{t.text}</p>
            </blockquote>
            <figcaption>
              <span class="testi-avatar" aria-hidden="true">{initials(t.name || 'Konsumen')}</span>
              <span class="testi-who">
                <span class="testi-name">{t.name || 'Konsumen'}</span>
                {t.rate && (
                  <span class="testi-stars" aria-label={`Rating ${t.rate} dari 5`}>
                    {STARS.map((s) => (
                      <svg key={s} viewBox="0 0 24 24" width="13" height="13" fill={s <= t.rate ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.3-5.7-3.1-5.7 3.1 1.2-6.3L2.8 9.5l6.4-.8L12 2.8z"/></svg>
                    ))}
                  </span>
                )}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .testi {
    background: var(--color-bg-main);
    padding-block: clamp(56px, 8vw, 108px);
  }
  .testi-head { text-align: center; margin-bottom: clamp(28px, 4vw, 46px); }
  .testi-head .eyebrow::before { display: none; }
  .testi-head .eyebrow { justify-content: center; }
  .testi-head h2 { margin-top: 14px; font-size: clamp(1.8rem, 3.4vw, 2.7rem); }
  .testi-list {
    display: grid;
    gap: var(--space-md);
  }
  .testi-card {
    margin: 0;
    background: var(--color-bg-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: clamp(26px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 22px;
    justify-content: space-between;
  }
  .testi-card blockquote { margin: 0; position: relative; }
  .testi-quote-mark {
    font-family: var(--font-display);
    font-size: 3.4rem;
    line-height: 0.6;
    color: var(--color-secondary);
    opacity: 0.75;
    display: block;
    height: 26px;
  }
  .testi-card blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 1.6vw, 1.4rem);
    font-style: italic;
    line-height: var(--leading-snug);
    color: var(--color-primary);
  }
  .testi-card figcaption {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .testi-avatar {
    width: 46px;
    height: 46px;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--color-dark);
    color: var(--color-gold-light);
    font-family: var(--font-display);
    font-size: 1.02rem;
    letter-spacing: 0.04em;
  }
  .testi-who { display: flex; flex-direction: column; gap: 5px; }
  .testi-name {
    font-weight: 600;
    font-size: 0.98rem;
    text-transform: capitalize;
  }
  .testi-stars { display: inline-flex; gap: 2px; color: var(--color-secondary); }
  @media (min-width: 700px) {
    .testi-list { grid-template-columns: repeat(2, 1fr); }
  }
</style>
