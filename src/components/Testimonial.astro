---
import Avatar from './Avatar.astro';
import { guessGender, prettifyName } from '../lib/gender.js';
import { buildWaLink } from '../lib/format.js';

const { testimonials = [], content = {} } = Astro.props;

// Cuma tampilkan entri yang beneran ada isinya (nama ATAU teks) - baris
// kosong di sheet jangan sampai jadi kartu hantu di halaman.
const items = (testimonials || [])
  .map((t) => {
    const name = prettifyName(t.name);
    const text = String(t.text || '').trim();
    // rate bisa datang sebagai angka, string angka, atau kosong - normalisasi
    // dan clamp 1..5. NaN/invalid => null (bintang gak dirender).
    const rateNum = Number(t.rate);
    const rate = Number.isFinite(rateNum) && rateNum > 0
      ? Math.min(5, Math.round(rateNum))
      : null;
    return { ...t, name, text, rate };
  })
  .filter((t) => t.name || t.text);

const hasItems = items.length > 0;

const waLink = buildWaLink(
  content.whatsapp_number,
  `Halo, saya penghuni/klien ${content.hero_title || 'properti ini'} dan mau berbagi pengalaman.`
);

// Array [1..5] buat render bintang.
const STARS = [1, 2, 3, 4, 5];
---

<section id="testimoni" class="testimonial-section">
  <div class="container">
    <div class="section-heading" data-reveal>
      <span class="eyebrow">Testimoni</span>
      <h2>Kata Klien &amp; Penghuni Kami</h2>
      <p class="section-sub">
        Cerita asli dari mereka yang sudah memilih tinggal di
        {content.hero_title || 'hunian kami'}.
      </p>
    </div>

    {hasItems ? (
      <div class="testimonial-grid">
        {items.map((t, i) => (
          <figure class="testimonial-card" data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
            <div class="quote-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                <path d="M10.7 5.6c-4.2 1.5-7 5-7 9.6 0 2.4 1.4 4.2 3.6 4.2 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3-3-3-.3 0-.7 0-1 .2.5-2.5 2.3-4.6 4.8-5.7l-.7-2.1zm9.3 0c-4.2 1.5-7 5-7 9.6 0 2.4 1.4 4.2 3.6 4.2 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3-3-3-.3 0-.7 0-1 .2.5-2.5 2.3-4.6 4.8-5.7l-.7-2.1z" />
              </svg>
            </div>

            {t.rate !== null && (
              <div
                class="stars"
                role="img"
                aria-label={`Rating ${t.rate} dari 5 bintang`}
              >
                {STARS.map((s) => (
                  <svg
                    viewBox="0 0 24 24"
                    width="17"
                    height="17"
                    fill={s <= t.rate ? 'currentColor' : 'none'}
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9 2.9-6z" />
                  </svg>
                ))}
              </div>
            )}

            {t.text && <blockquote class="testimonial-text">{t.text}</blockquote>}

            <figcaption class="testimonial-person">
              <Avatar gender={guessGender(t.name)} name={t.name} photoUrl={t.photo_url || t.avatar_url || null} size={48} />
              <div>
                <span class="testimonial-name">{t.name || 'Pemberi Testimoni'}</span>
                <span class="testimonial-role">{content.company_name || 'Klien Kami'}</span>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="testimonial-empty" data-reveal>
        <div class="empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
        </div>
        <h3>Testimoni Akan Segera Hadir</h3>
        <p>
          Kami sedang mengumpulkan cerita dari penghuni dan klien
          {content.hero_title ? content.hero_title : 'kami'}. Jadikan pengalaman
          Anda yang pertama kami ceritakan di sini.
        </p>
        {content.whatsapp_number && (
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark empty-cta">
            Bagikan Pengalaman Anda
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .testimonial-section {
    padding-block: var(--space-xl);
    background: var(--color-bg-main);
  }
  .section-heading {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .eyebrow {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-gold);
    margin-bottom: var(--space-xs);
  }
  .section-heading h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--color-navy);
  }
  .section-sub {
    max-width: 520px;
    margin: var(--space-xs) auto 0;
    color: var(--color-navy-soft);
    font-size: 0.95rem;
  }

  /* --- Grid kartu testimoni --- */
  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-md);
  }
  .testimonial-card {
    position: relative;
    background: var(--color-bg-paper);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: calc(var(--space-md) + 8px) var(--space-md) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    transition: transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }
  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .quote-mark {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    color: color-mix(in srgb, var(--color-gold) 45%, white);
  }
  .stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-gold);
  }
  .testimonial-text {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-navy);
    flex-grow: 1;
  }
  .testimonial-person {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    border-top: var(--border-width) solid var(--color-border);
    padding-top: var(--space-sm);
  }
  .avatar {
    flex-shrink: 0;
    border-radius: var(--radius-full);
    display: block;
  }
  .avatar-photo {
    object-fit: cover;
  }
  .testimonial-name {
    display: block;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-navy);
    line-height: 1.3;
  }
  .testimonial-role {
    display: block;
    font-size: 0.78rem;
    color: var(--color-navy-soft);
  }

  /* --- Empty state (data testimoni belum ada di sheet) --- */
  .testimonial-empty {
    max-width: 520px;
    margin-inline: auto;
    text-align: center;
    background: var(--color-bg-paper);
    border: 1.5px dashed color-mix(in srgb, var(--color-gold) 55%, transparent);
    border-radius: var(--radius-lg);
    padding: calc(var(--space-lg) - 8px) var(--space-md) var(--space-lg);
  }
  .empty-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-sm);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-gold-soft);
    color: color-mix(in srgb, var(--color-gold) 75%, var(--color-navy));
  }
  .testimonial-empty h3 {
    font-size: 1.25rem;
    color: var(--color-navy);
    margin-bottom: var(--space-xs);
  }
  .testimonial-empty p {
    font-size: 0.92rem;
    color: var(--color-navy-soft);
    margin-bottom: var(--space-md);
  }
  .empty-cta {
    padding: 11px 26px;
    font-size: 0.9rem;
  }
</style>
