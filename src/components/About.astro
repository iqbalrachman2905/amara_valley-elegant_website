---
import { buildWaLink, splitNarrativeParagraphs } from '../lib/format.js';
import { aboutFacts } from '../lib/derive.js';

const { content, units = [], aboutImgs = [] } = Astro.props;
const waLink = buildWaLink(content.whatsapp_number, `Halo, saya ingin konsultasi & jadwal survey ${content.hero_title || 'Amara Valley'}.`);

// Narasi Tentang 100% dari key about_description di sheet. Sel yang kena
// artefak paste kode JS (sisa `',` / `'`) otomatis dibersihkan per baris.
const paragraphs = splitNarrativeParagraphs(content.about_description);

// Fakta ringkas dihitung dari data: luas dari sheet Unit, kamar mandi &
// carport dari key "rumah". Dulunya angka-angka ini ditulis mati di sini.
const facts = aboutFacts(content, units);
---

<section id="tentang" class="about">
  <div class="container about-grid">
    <div class="about-media" data-reveal>
      {aboutImgs[0] && (
        <figure class="about-media-main">
          <img
            src={aboutImgs[0].src}
            alt="Suasana hunian Amara Valley"
            width={aboutImgs[0].width}
            height={aboutImgs[0].height}
            loading="lazy"
          />
        </figure>
      )}
      {aboutImgs[1] && (
        <figure class="about-media-side">
          <img
            src={aboutImgs[1].src}
            alt="Detail hunian Amara Valley"
            width={aboutImgs[1].width}
            height={aboutImgs[1].height}
            loading="lazy"
          />
        </figure>
      )}
      <span class="about-media-caption">
        {content.badge_text || 'Kelapa Dua · Depok'}
      </span>
    </div>

    <div class="about-body">
      <p class="eyebrow" data-reveal>Tentang Klaster</p>
      <h2 class="about-title" data-reveal>
        Klasik yang tenang,
        <em class="accent-serif">modern</em> yang hangat.
      </h2>

      <div class="about-text" data-reveal>
        {paragraphs.map(p => <p>{p}</p>)}
      </div>

      {facts.length > 0 && (
        <dl class="about-facts" data-reveal>
          {facts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <div class="about-actions" data-reveal>
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-ink">
          Konsultasi &amp; Jadwal Survey
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m0 0-6-6m6 6-6 6"/></svg>
        </a>
        <a href="#unit" class="btn btn-outline">Lihat Denah Unit</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-bg-main);
    padding-block: clamp(72px, 11vw, 128px);
  }
  .about-grid {
    display: grid;
    gap: clamp(36px, 6vw, 72px);
    align-items: center;
  }

  /* --- Komposisi media editorial --- */
  .about-media {
    position: relative;
    max-width: 560px;
  }
  .about-media-main {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }
  .about-media-main::before {
    content: '';
    position: absolute;
    inset: -14px -14px auto auto;
    width: 46%;
    height: 46%;
    border-top: 1px solid var(--color-secondary);
    border-right: 1px solid var(--color-secondary);
    border-radius: 0 var(--radius-md) 0 0;
    z-index: 2;
  }
  .about-media-main img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out);
  }
  .about-media:hover .about-media-main img { transform: scale(1.03); }
  .about-media-side {
    position: absolute;
    right: -6%;
    bottom: -14%;
    width: 52%;
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 8px solid var(--color-bg-main);
    box-shadow: var(--shadow-xl);
    z-index: 3;
  }
  .about-media-side img {
    width: 100%;
    aspect-ratio: 4 / 3.2;
    object-fit: cover;
  }
  .about-media-caption {
    position: absolute;
    left: 18px;
    bottom: -34px;
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    color: var(--color-secondary);
  }

  /* --- Teks --- */
  .about-body { max-width: 640px; }
  .about-title {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    margin: 18px 0 26px;
  }
  .about-title em { font-size: 1.04em; }
  .about-text p {
    margin-bottom: 16px;
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
  }

  .about-facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-block: 30px;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }
  .fact {
    padding: 16px 18px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-paper);
  }
  .fact dt {
    font-size: 0.64rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-secondary);
    margin-bottom: 6px;
  }
  .fact dd {
    font-family: var(--font-display);
    font-size: 1.28rem;
    color: var(--color-primary);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  @media (min-width: 1000px) {
    .about-grid { grid-template-columns: minmax(0, 0.95fr) 1.05fr; }
    .about-media { justify-self: end; }
    .about-body { padding-left: 0; }
    .about-media { padding-bottom: 64px; }
    .about-media-caption { bottom: 8px; }
  }
</style>
